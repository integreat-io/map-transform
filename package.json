{
  "name": "map-transform",
  "version": "1.6.0-rc.6",
  "description": "Map and transform objects with mapping definitions",
  "author": "Kjell-Morten Bratsberg Thorsen <kjellmorten@integreat.io>",
  "license": "ISC",
  "keywords": [
    "map",
    "transform",
    "javascript",
    "object",
    "path"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./definitionHelpers.js": {
      "import": "./dist/utils/definitionHelpers.js",
      "types": "./dist/utils/definitionHelpers.d.ts"
    },
    "./types.js": {
      "types": "./dist/types.d.ts"
    },
    "./next": {
      "import": "./dist/mapTransform.js",
      "types": "./dist/mapTransform.d.ts"
    },
    "./typesNext.js": {
      "types": "./dist/typesNext.d.ts"
    }
  },
  "scripts": {
    "test": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-reporter node-test-reporter 'src/**/*.test.ts'",
    "test:legacy": "node --import tsx --no-deprecation --test --enable-source-maps src/*.test.ts src/**/*.test.ts",
    "test:watch": "npm run dev",
    "dev": "node --import tsx --test --enable-source-maps --test-reporter node-test-reporter --watch 'src/**/*.test.ts' || exit 0",
    "test:perf": "node --import tsx --test --enable-source-maps --test-reporter node-test-reporter 'src/legacy/performance/**/*.ts'",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "tsc --noEmit --strict",
    "verify": "npm run lint && npm run check-types && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/integreat-io/map-transform.git"
  },
  "engines": {
    "node": ">= 14"
  },
  "bugs": {
    "url": "https://github.com/integreat-io/map-transform/issues"
  },
  "homepage": "https://github.com/integreat-io/map-transform#readme",
  "dependencies": {
    "deepmerge-ts": "^8.0.2",
    "map-any": "^1.0.0"
  },
  "devDependencies": {
    "@integreat/ts-dev-setup": "^10.0.0",
    "@types/deep-freeze": "^0.1.5",
    "@types/node": "^26.4.0",
    "@types/sinon": "^22.0.0",
    "deep-freeze": "0.0.1",
    "sinon": "^22.1.0"
  }
}
